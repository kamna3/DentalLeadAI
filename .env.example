# ----------------------------------------------------
# DentalLead AI - Production Environment Configuration
# ----------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI Receptionist and Revenue Leak scanner.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted on Cloud Run / custom domain.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for website widget loaders, OAuth callbacks, and inbound Twilio SMS webhooks.
APP_URL="https://my-app.run.app"

# ENVIRONMENT & NETWORKING
NODE_ENV="production"
PORT=3000

# WEBHOOK SECURITY: Secret token to sign and verify inbound Twilio, Zapier, and Payment webhooks.
WEBHOOK_SECRET="whsec_dental_lead_ai_demo_secret_token"

# PAYMENT & BILLING (Payoneer / Stripe)
PAYONEER_MERCHANT_ID="merchant_dental_smile_48291"

# TWILIO TELECOM (Optional for live outbound carrier SMS delivery)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
